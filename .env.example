# Environment Configuration Template
NODE_ENV=development
PORT=5000

# Frontend
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_erp
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_erp
DB_USER=postgres
DB_PASSWORD=your_password
DB_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-64-chars-long-for-security
JWT_REFRESH_SECRET=another-super-secret-refresh-key-min-64-chars-long-for-security
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=app-specific-password
SMTP_FROM=noreply@schoolerp.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_PHONE=+1234567890

# File Storage (AWS S3 / Supabase Storage)
S3_BUCKET=school-erp-uploads
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Payment Gateway (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your-secret

# AI / Gemini (for AI timetable & analytics)
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# GPS/Tracking
GPS_WEBSOCKET_PORT=3001
